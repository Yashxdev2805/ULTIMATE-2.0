# ==========================================
# Thinkkaro (RepairHub) - Workspace .gitignore
# ==========================================

# ------------------------------------------
# Excluded Documentation & Specifications
# ------------------------------------------
PRD/
/PRD
*.md
!README.md

# ------------------------------------------
# Excluded Python & Backend Requirements
# ------------------------------------------
venv/
.venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
*.db
*.sqlite
*.sqlite3

# ------------------------------------------
# Environment Files & Credentials
# ------------------------------------------
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# ------------------------------------------
# Node Dependencies & Build Outputs
# ------------------------------------------
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
build/
dist/
/.pnp
.pnp.*

# ------------------------------------------
# Testing & Coverage
# ------------------------------------------
coverage/
.nyc_output/

# ------------------------------------------
# Logs & Temp Files
# ------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tmp

# ------------------------------------------
# IDE & System Files
# ------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
.gemini/

# ------------------------------------------
# Next.js & Turbopack
# ------------------------------------------
.vercel
*.tsbuildinfo
next-env.d.ts
frontend/next-env.d.ts
